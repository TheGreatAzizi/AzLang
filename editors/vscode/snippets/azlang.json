{
  "Function": {
    "prefix": "fun",
    "body": [
      "fun ${1:name}(${2:args})",
      "  ${3:return ${4:null}}",
      "end"
    ],
    "description": "Define a function"
  },
  "Async function": {
    "prefix": "asyncfun",
    "body": [
      "async fun ${1:name}(${2:args})",
      "  return await ${3:work()}",
      "end"
    ],
    "description": "Define an asynchronous function"
  },
  "If / else": {
    "prefix": "if",
    "body": [
      "if ${1:condition}",
      "  ${2:say \"yes\"}",
      "else",
      "  ${3:say \"no\"}",
      "end"
    ],
    "description": "If / else block"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items}",
      "  ${3:say item}",
      "end"
    ],
    "description": "Loop through a list or map"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition}",
      "  ${2:# body}",
      "end"
    ],
    "description": "While loop"
  },
  "Repeat": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3}",
      "  ${2:say \"again\"}",
      "end"
    ],
    "description": "Repeat a block a fixed number of times"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}${2: extends Parent}",
      "  fun init(${3:args})",
      "    ${4:this.value = value}",
      "  end",
      "",
      "  fun ${5:method}()",
      "    return ${6:this.value}",
      "  end",
      "end"
    ],
    "description": "Define a class"
  },
  "Try / catch": {
    "prefix": "try",
    "body": [
      "try",
      "  ${1:risky()}",
      "catch ${2:problem}",
      "  say \"Error: {${2:problem}.message}\"",
      "end"
    ],
    "description": "Recover from a runtime error"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value}",
      "  case ${2:expected}",
      "    ${3:say \"matched\"}",
      "  case _",
      "    ${4:say \"anything else\"}",
      "end"
    ],
    "description": "Pattern matching block"
  },
  "Say with interpolation": {
    "prefix": "sayf",
    "body": [
      "say \"${1:Hello}, {${2:name}}!\""
    ],
    "description": "Print a string with an interpolated value"
  },
  "Import module": {
    "prefix": "import",
    "body": [
      "import ${1:name} from \"${2:./module.az}\""
    ],
    "description": "Import a module as a namespace"
  },
  "Named import": {
    "prefix": "importn",
    "body": [
      "import { ${1:name} } from \"${2:./module.az}\""
    ],
    "description": "Import selected names from a module"
  },
  "Export function": {
    "prefix": "exportfun",
    "body": [
      "export fun ${1:name}(${2:args})",
      "  ${3:return null}",
      "end"
    ],
    "description": "Export a function from a module"
  },
  "HTTP request": {
    "prefix": "http",
    "body": [
      "async fun ${1:fetch_data}()",
      "  let response = await http_get(\"${2:https://example.com/api}\", {timeout_ms: ${3:10000}})",
      "  raise_for_status(response)",
      "  return response_json(response)",
      "end"
    ],
    "description": "Fetch and decode a JSON API"
  },
  "Main program": {
    "prefix": "azmain",
    "body": [
      "# ${1:Description}",
      "",
      "fun main()",
      "  ${2:say \"Hello, world!\"}",
      "end",
      "",
      "main()"
    ],
    "description": "A complete starter program"
  }
}

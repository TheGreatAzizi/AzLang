%YAML 1.2
---
name: AzLang
file_extensions:
  - az
scope: source.azlang

contexts:
  main:
    - include: comments
    - include: strings
    - include: declarations
    - include: keywords
    - include: constants
    - include: builtins
    - include: calls
    - include: numbers
    - include: operators
    - include: punctuation
    - include: identifiers

  comments:
    - match: '#.*$'
      scope: comment.line.number-sign.azlang

  strings:
    - match: '\br"""'
      scope: string.quoted.triple.raw.azlang
      push:
        - meta_scope: string.quoted.triple.raw.azlang
        - match: '"""'
          pop: true
    - match: "\\br'''"
      scope: string.quoted.triple.raw.azlang
      push:
        - meta_scope: string.quoted.triple.raw.azlang
        - match: "'''"
          pop: true
    - match: '"""'
      scope: punctuation.definition.string.begin.azlang
      push:
        - meta_scope: string.quoted.triple.azlang
        - include: escapes
        - include: interpolation
        - match: '"""'
          scope: punctuation.definition.string.end.azlang
          pop: true
    - match: "'''"
      scope: punctuation.definition.string.begin.azlang
      push:
        - meta_scope: string.quoted.triple.azlang
        - include: escapes
        - include: interpolation
        - match: "'''"
          scope: punctuation.definition.string.end.azlang
          pop: true
    - match: '\br"'
      scope: string.quoted.double.raw.azlang
      push:
        - meta_scope: string.quoted.double.raw.azlang
        - match: '"'
          pop: true
    - match: "\\br'"
      scope: string.quoted.single.raw.azlang
      push:
        - meta_scope: string.quoted.single.raw.azlang
        - match: "'"
          pop: true
    - match: '"'
      scope: punctuation.definition.string.begin.azlang
      push:
        - meta_scope: string.quoted.double.azlang
        - include: escapes
        - include: interpolation
        - match: '"'
          scope: punctuation.definition.string.end.azlang
          pop: true
    - match: "'"
      scope: punctuation.definition.string.begin.azlang
      push:
        - meta_scope: string.quoted.single.azlang
        - include: escapes
        - include: interpolation
        - match: "'"
          scope: punctuation.definition.string.end.azlang
          pop: true

  escapes:
    - match: '\\.'
      scope: constant.character.escape.azlang

  interpolation:
    - match: '\{'
      scope: punctuation.section.interpolation.begin.azlang
      push:
        - meta_scope: meta.interpolation.azlang
        - include: keywords
        - include: constants
        - include: builtins
        - include: calls
        - include: numbers
        - include: operators
        - include: identifiers
        - match: '\}'
          scope: punctuation.section.interpolation.end.azlang
          pop: true

  declarations:
    - match: '\b(class|extends|new)\s+([A-Za-z_\p{L}][A-Za-z0-9_\p{L}\p{N}]*)'
      captures:
        1: keyword.other.azlang
        2: entity.name.type.class.azlang
    - match: '\b(fun)\s+([A-Za-z_\p{L}][A-Za-z0-9_\p{L}\p{N}]*)'
      captures:
        1: keyword.other.azlang
        2: entity.name.function.azlang

  keywords:
    - match: '\b(let|const|say|if|elif|else|end|while|for|in|repeat|break|continue|fun|return|class|extends|new|try|catch|throw|match|case|default|async|await|import|export)\b'
      scope: keyword.control.azlang
    - match: '\b(and|or|not)\b'
      scope: keyword.operator.word.azlang

  constants:
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.azlang
    - match: '\bnull\b'
      scope: constant.language.null.azlang
    - match: '\b(this|super)\b'
      scope: variable.language.azlang
    - match: '\b(PI|E|TAU)\b'
      scope: support.constant.azlang

  builtins:
    - match: '\b(abs|all|any|append|assert|avg|base64_decode|base64_encode|bool|capitalize|ceil|center|char_code|chars|choice|chunk|clamp|clock|coalesce|compact|concat|contains|count|count_by|count_text|difference|discard|drop|each|ends|ends_with|ensure_list|ensure_map|enumerate|escape_html|fail|fallback|filter|find|find_index|find_item|first|flat_map|flatten|floor|from_char|from_entries|from_json|get|get_in|get_path|graphql|group_by|has|has_key|has_path|http_delete|http_get|http_get_json|http_patch|http_post|http_post_json|http_put|http_request|index_by|index_of|input|insert|int|intersection|invert|is_bool|is_empty|is_function|is_list|is_map|is_missing|is_null|is_number|is_string|items|join|json_decode|json_encode|keys|last|len|lines|list|log|lower|lstrip|map|map_keys|map_values|max|max_by|merge|min|min_by|num|omit|or_else|pad_left|pad_right|partition|pick|pop|pow|prepend|raise_for_status|random|random_float|range|reduce|remove|remove_prefix|remove_suffix|repeat_text|replace|replace_first|response_json|response_text|retry|reverse|reverse_text|reversed|rfind|round|rstrip|set|sleep|slice|sort|sort_by|sorted|split|sqrt|starts|starts_with|str|strip|substring|sum|sum_by|take|title|to_json|trim|truncate|type|union|unique|update|upper|url_decode|url_encode|values|without|words|zfill|zip|net|Promise)\b'
      scope: support.function.builtin.azlang

  calls:
    - match: '\b([A-Za-z_\p{L}][A-Za-z0-9_\p{L}\p{N}]*)\s*(?=\()'
      captures:
        1: entity.name.function.azlang

  numbers:
    - match: '\b[0-9۰-۹٠-٩]+(?:\.[0-9۰-۹٠-٩]+)?\b'
      scope: constant.numeric.azlang

  operators:
    - match: '\*\*=|//=|\*\*|==|!=|<=|>=|//|=>|\+=|-=|\*=|/=|%=|[+\-*/%=<>!]'
      scope: keyword.operator.azlang

  punctuation:
    - match: '[(){}\[\],.:;]'
      scope: punctuation.azlang

  identifiers:
    - match: '[A-Za-z_\p{L}][A-Za-z0-9_\p{L}\p{N}]*'
      scope: variable.other.azlang

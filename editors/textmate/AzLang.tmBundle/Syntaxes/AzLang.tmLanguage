<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key>
  <string>AzLang</string>
  <key>scopeName</key>
  <string>source.azlang</string>
  <key>fileTypes</key>
  <array>
    <string>az</string>
  </array>
  <key>patterns</key>
  <array>
    <dict><key>include</key><string>#comments</string></dict>
    <dict><key>include</key><string>#raw-triple-double</string></dict>
    <dict><key>include</key><string>#raw-triple-single</string></dict>
    <dict><key>include</key><string>#triple-double</string></dict>
    <dict><key>include</key><string>#triple-single</string></dict>
    <dict><key>include</key><string>#raw-double</string></dict>
    <dict><key>include</key><string>#raw-single</string></dict>
    <dict><key>include</key><string>#double-quoted</string></dict>
    <dict><key>include</key><string>#single-quoted</string></dict>
    <dict><key>include</key><string>#class-declaration</string></dict>
    <dict><key>include</key><string>#function-declaration</string></dict>
    <dict><key>include</key><string>#keywords</string></dict>
    <dict><key>include</key><string>#constants</string></dict>
    <dict><key>include</key><string>#language-variables</string></dict>
    <dict><key>include</key><string>#logical-operators</string></dict>
    <dict><key>include</key><string>#builtins</string></dict>
    <dict><key>include</key><string>#builtin-constants</string></dict>
    <dict><key>include</key><string>#function-call</string></dict>
    <dict><key>include</key><string>#numbers</string></dict>
    <dict><key>include</key><string>#operators</string></dict>
    <dict><key>include</key><string>#punctuation</string></dict>
    <dict><key>include</key><string>#identifiers</string></dict>
  </array>
  <key>repository</key>
  <dict>
    <key>comments</key>
    <dict>
      <key>name</key>
      <string>comment.line.number-sign.azlang</string>
      <key>match</key>
      <string>#.*$</string>
    </dict>

    <key>raw-triple-double</key>
    <dict>
      <key>name</key>
      <string>string.quoted.triple.raw.azlang</string>
      <key>begin</key>
      <string>\br"""</string>
      <key>end</key>
      <string>"""</string>
    </dict>
    <key>raw-triple-single</key>
    <dict>
      <key>name</key>
      <string>string.quoted.triple.raw.azlang</string>
      <key>begin</key>
      <string>\br'''</string>
      <key>end</key>
      <string>'''</string>
    </dict>
    <key>triple-double</key>
    <dict>
      <key>name</key>
      <string>string.quoted.triple.azlang</string>
      <key>begin</key>
      <string>"""</string>
      <key>end</key>
      <string>"""</string>
      <key>patterns</key>
      <array>
        <dict><key>name</key><string>constant.character.escape.azlang</string><key>match</key><string>\\.</string></dict>
        <dict><key>include</key><string>#interpolation</string></dict>
      </array>
    </dict>
    <key>triple-single</key>
    <dict>
      <key>name</key>
      <string>string.quoted.triple.azlang</string>
      <key>begin</key>
      <string>'''</string>
      <key>end</key>
      <string>'''</string>
      <key>patterns</key>
      <array>
        <dict><key>name</key><string>constant.character.escape.azlang</string><key>match</key><string>\\.</string></dict>
        <dict><key>include</key><string>#interpolation</string></dict>
      </array>
    </dict>
    <key>raw-double</key>
    <dict>
      <key>name</key>
      <string>string.quoted.double.raw.azlang</string>
      <key>begin</key>
      <string>\br"</string>
      <key>end</key>
      <string>"</string>
    </dict>
    <key>raw-single</key>
    <dict>
      <key>name</key>
      <string>string.quoted.single.raw.azlang</string>
      <key>begin</key>
      <string>\br'</string>
      <key>end</key>
      <string>'</string>
    </dict>
    <key>double-quoted</key>
    <dict>
      <key>name</key>
      <string>string.quoted.double.azlang</string>
      <key>begin</key>
      <string>"</string>
      <key>end</key>
      <string>"</string>
      <key>patterns</key>
      <array>
        <dict><key>name</key><string>constant.character.escape.azlang</string><key>match</key><string>\\.</string></dict>
        <dict><key>include</key><string>#interpolation</string></dict>
      </array>
    </dict>
    <key>single-quoted</key>
    <dict>
      <key>name</key>
      <string>string.quoted.single.azlang</string>
      <key>begin</key>
      <string>'</string>
      <key>end</key>
      <string>'</string>
      <key>patterns</key>
      <array>
        <dict><key>name</key><string>constant.character.escape.azlang</string><key>match</key><string>\\.</string></dict>
        <dict><key>include</key><string>#interpolation</string></dict>
      </array>
    </dict>

    <key>interpolation</key>
    <dict>
      <key>name</key>
      <string>meta.interpolation.azlang</string>
      <key>begin</key>
      <string>\{</string>
      <key>end</key>
      <string>\}</string>
      <key>patterns</key>
      <array>
        <dict><key>include</key><string>#expression</string></dict>
      </array>
    </dict>
    <key>expression</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict><key>include</key><string>#constants</string></dict>
        <dict><key>include</key><string>#language-variables</string></dict>
        <dict><key>include</key><string>#logical-operators</string></dict>
        <dict><key>include</key><string>#builtins</string></dict>
        <dict><key>include</key><string>#builtin-constants</string></dict>
        <dict><key>include</key><string>#function-call</string></dict>
        <dict><key>include</key><string>#numbers</string></dict>
        <dict><key>include</key><string>#strings</string></dict>
        <dict><key>include</key><string>#operators</string></dict>
        <dict><key>include</key><string>#identifiers</string></dict>
      </array>
    </dict>
    <key>strings</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict><key>include</key><string>#double-quoted</string></dict>
        <dict><key>include</key><string>#single-quoted</string></dict>
      </array>
    </dict>

    <key>class-declaration</key>
    <dict>
      <key>match</key>
      <string>\b(class|extends|new)\s+([A-Za-z_\p{L}][A-Za-z0-9_\p{L}\p{N}\p{Mn}\p{Mc}]*)</string>
      <key>captures</key>
      <dict>
        <key>1</key>
        <dict><key>name</key><string>keyword.other.azlang</string></dict>
        <key>2</key>
        <dict><key>name</key><string>entity.name.type.class.azlang</string></dict>
      </dict>
    </dict>
    <key>function-declaration</key>
    <dict>
      <key>match</key>
      <string>\b(fun)\s+([A-Za-z_\p{L}][A-Za-z0-9_\p{L}\p{N}\p{Mn}\p{Mc}]*)</string>
      <key>captures</key>
      <dict>
        <key>1</key>
        <dict><key>name</key><string>keyword.other.azlang</string></dict>
        <key>2</key>
        <dict><key>name</key><string>entity.name.function.azlang</string></dict>
      </dict>
    </dict>

    <key>keywords</key>
    <dict>
      <key>name</key>
      <string>keyword.control.azlang</string>
      <key>match</key>
      <string>\b(?:let|const|say|if|elif|else|end|while|for|in|repeat|break|continue|fun|return|class|extends|new|try|catch|throw|match|case|default|async|await|import|export)\b</string>
    </dict>
    <key>constants</key>
    <dict>
      <key>patterns</key>
      <array>
        <dict><key>name</key><string>constant.language.boolean.azlang</string><key>match</key><string>\b(?:true|false)\b</string></dict>
        <dict><key>name</key><string>constant.language.null.azlang</string><key>match</key><string>\bnull\b</string></dict>
      </array>
    </dict>
    <key>language-variables</key>
    <dict>
      <key>name</key>
      <string>variable.language.azlang</string>
      <key>match</key>
      <string>\b(?:this|super)\b</string>
    </dict>
    <key>logical-operators</key>
    <dict>
      <key>name</key>
      <string>keyword.operator.word.azlang</string>
      <key>match</key>
      <string>\b(?:and|or|not)\b</string>
    </dict>
    <key>builtins</key>
    <dict>
      <key>name</key>
      <string>support.function.builtin.azlang</string>
      <key>match</key>
      <string>\b(?:abs|all|any|append|assert|avg|base64_decode|base64_encode|bool|capitalize|ceil|center|char_code|chars|choice|chunk|clamp|clock|coalesce|compact|concat|contains|count|count_by|count_text|difference|discard|drop|each|ends|ends_with|ensure_list|ensure_map|enumerate|escape_html|fail|fallback|filter|find|find_index|find_item|first|flat_map|flatten|floor|from_char|from_entries|from_json|get|get_in|get_path|graphql|group_by|has|has_key|has_path|http_delete|http_get|http_get_json|http_patch|http_post|http_post_json|http_put|http_request|index_by|index_of|input|insert|int|intersection|invert|is_bool|is_empty|is_function|is_list|is_map|is_missing|is_null|is_number|is_string|items|join|json_decode|json_encode|keys|last|len|lines|list|log|lower|lstrip|map|map_keys|map_values|max|max_by|merge|min|min_by|num|omit|or_else|pad_left|pad_right|partition|pick|pop|pow|prepend|raise_for_status|random|random_float|range|reduce|remove|remove_prefix|remove_suffix|repeat_text|replace|replace_first|response_json|response_text|retry|reverse|reverse_text|reversed|rfind|round|rstrip|set|sleep|slice|sort|sort_by|sorted|split|sqrt|starts|starts_with|str|strip|substring|sum|sum_by|take|title|to_json|trim|truncate|type|union|unique|update|upper|url_decode|url_encode|values|without|words|zfill|zip|net|Promise)\b</string>
    </dict>
    <key>builtin-constants</key>
    <dict>
      <key>name</key>
      <string>support.constant.azlang</string>
      <key>match</key>
      <string>\b(?:PI|E|TAU)\b</string>
    </dict>
    <key>function-call</key>
    <dict>
      <key>match</key>
      <string>\b([A-Za-z_\p{L}][A-Za-z0-9_\p{L}\p{N}\p{Mn}\p{Mc}]*)\s*(?=\()</string>
      <key>captures</key>
      <dict>
        <key>1</key>
        <dict><key>name</key><string>entity.name.function.azlang</string></dict>
      </dict>
    </dict>
    <key>numbers</key>
    <dict>
      <key>name</key>
      <string>constant.numeric.azlang</string>
      <key>match</key>
      <string>\b[0-9۰-۹٠-٩]+(?:\.[0-9۰-۹٠-٩]+)?\b</string>
    </dict>
    <key>operators</key>
    <dict>
      <key>name</key>
      <string>keyword.operator.azlang</string>
      <key>match</key>
      <string>\*\*=|//=|\*\*|==|!=|&lt;=|&gt;=|//|=&gt;|\+=|-=|\*=|/=|%=|[+\-*/%=&lt;&gt;!]</string>
    </dict>
    <key>punctuation</key>
    <dict>
      <key>name</key>
      <string>punctuation.azlang</string>
      <key>match</key>
      <string>[(){}\[\],.:;]</string>
    </dict>
    <key>identifiers</key>
    <dict>
      <key>name</key>
      <string>variable.other.azlang</string>
      <key>match</key>
      <string>[A-Za-z_\p{L}][A-Za-z0-9_\p{L}\p{N}\p{Mn}\p{Mc}]*</string>
    </dict>
  </dict>
</dict>
</plist>

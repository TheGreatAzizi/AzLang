# The full content of every interactive showcase tab. The page embeds this
# list as JSON and assets/site.js only handles the tab switching.
let showcase_samples = [
  {
    id: "functional",
    title: "Functional style",
    desc: "Lambdas and higher-order helpers let you say what you mean, not how to loop.",
    code: r"""# Numbers with a purpose
let numbers = range(1, 11)

let squares = map(numbers, n => n * n)
let evens = filter(numbers, n => n % 2 == 0)
let total = reduce(numbers, (a, b) => a + b)

say squares
say evens
say "Sum: {total}"

# [1, 4, 9, 16, 25, 36, 49, 64, 81, 100]
# [2, 4, 6, 8, 10]
# Sum: 55""",
    bullets: [
      'Arrow lambdas: <span class="mono">x =&gt; x * 2</span>',
      "map, filter, reduce, any, all",
      'Destructuring: <span class="mono">for i, v in enumerate(list)</span>',
      "Strings interpolate any expression"
    ]
  },
  {
    id: "objects",
    title: "Classes & inheritance",
    desc: "Model real things with classes, share behavior with extends, and reuse parent logic with super.",
    code: r"""class Animal
  fun init(name, sound)
    this.name = name
    this.sound = sound
  end

  fun speak()
    return "{this.name} says {this.sound}"
  end
end

class Dog extends Animal
  fun init(name)
    super(name, "woof")
  end

  fun fetch()
    return "{this.name} fetches the ball!"
  end
end

let rex = new Dog("Rex")
say rex.speak()
say rex.fetch()""",
    bullets: [
      '<span class="mono">init</span> runs when you create an instance',
      "Methods are inherited automatically",
      '<span class="mono">super(...)</span> calls the parent constructor',
      "Override methods just by redefining them"
    ]
  },
  {
    id: "errors",
    title: "Errors & matching",
    desc: "Recover from failure with try/catch, and choose behavior with readable match blocks.",
    code: r"""fun describe(value)
  match type(value)
    case "number"
      return "a number: {value}"
    case "string"
      return "text with {len(value)} characters"
    case _
      return "something else"
  end
end

try
  throw {message: "Out of stock", code: 404}
catch problem
  say "Error {problem.code}: {problem.message}"
end

say describe(42)
say describe("AzLang")""",
    bullets: [
      "Throw any value, catch it by name",
      "Runtime errors are catchable too",
      '<span class="mono">match</span> works with lists, maps, and <span class="mono">_</span>',
      'Multiple values per case: <span class="mono">case 1, 2, 3</span>'
    ]
  },
  {
    id: "network",
    title: "Async & APIs",
    desc: "Call real web APIs with async/await, check the status, and read optional fields without crashing.",
    code: r"""import net from "net"

async fun repo(name)
  let res = await net.get(
    "https://api.github.com/repos/TheGreatAzizi/" + name,
    {headers: {"User-Agent": "AzLang"}, timeout_ms: 10000}
  )
  net.raise_for_status(res)
  return net.json(res)
end

let data = await repo("AzLang")
say get_path(data, "full_name", "unknown")
say get_path(data, "stargazers_count", 0)""",
    bullets: [
      '<span class="mono">async fun</span> and <span class="mono">await</span>',
      "Headers, query parameters, timeouts, and JSON bodies",
      "Structured HTTP and GraphQL errors",
      'Optional data via <span class="mono">get_path</span>'
    ]
  }
]


      <div class="section-head reveal">
        <span class="eyebrow">A real language</span>
        <h2>See it in action.</h2>
        <p>Three small programs that show what AzLang can do. Every snippet runs as-is in the Studio.</p>
      </div>

      <div class="showcase-box reveal">
        <div class="tabs" role="tablist" aria-label="Code examples">""")

for i in range(len(showcase_tabs))
  let tab = showcase_tabs[i]
  let active = ""
  let selected = "false"
  if i == 0
    active = " active"
    selected = "true"
  end
  add('          <button class="tab-btn' + active + '" role="tab" aria-selected="' + selected + '" data-tab="' + tab.id + '"><span class="n">' + tab.number + '</span> ' + tab.label + '</button>')
end

add(r"""          <a class="tab-btn" href="ide.html" style="margin-left:auto;color:var(--teal)"><svg class="ic" style="width:13px;height:13px"><use href="#i-play"/></svg> Run in Studio</a>
        </div>

        <div class="showcase-body">
          <pre class="showcase-code" id="showcaseCode">""" + code_sample(showcase_samples[0].code) + r"""</pre>
          <aside class="showcase-side">
            <div>
              <h3 id="showcaseTitle">""" + showcase_samples[0].title + r"""</h3>
              <p id="showcaseDesc">""" + showcase_samples[0].desc + r"""</p>
            </div>
            <ul id="showcaseList">""")

for bullet in showcase_samples[0].bullets
  add('              <li><span class="tick"><svg aria-hidden="true"><use href="#i-check"/></svg></span><span>' + bullet + '</span></li>')
end

add(r"""            </ul>
            <div class="side-cta">
              <a href="docs.html#functions">Explore functions in the docs <svg class="ic" style="width:12px;height:12px"><use href="#i-arrow"/></svg></a>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>""")

# ------------------------------------------------------------
# Errors section
# ------------------------------------------------------------

add(r"""  <section id="errors">
    <div class="wrap errors-split">
      <div class="errors-copy reveal">
        <span class="eyebrow">Kind by design</span>
        <h2>Mistakes are part of learning. The messages should help.</h2>
        <p>
          AzLang never answers a typo with a cryptic stack trace. Every error tells you
          what happened, where it happened, and what to try next.
        </p>
        <ul>
          <li><span class="dot"></span>Clear messages in plain English</li>
          <li><span class="dot"></span>Exact line numbers, shown in the editor</li>
          <li><span class="dot"></span>Hints and close-name suggestions</li>
          <li><span class="dot"></span>Catchable errors with <code>try</code> / <code>catch</code></li>
        </ul>
      </div>

      <div class="error-window reveal">
        <div class="card-head">
          <div class="dots"><i></i><i></i><i></i></div>
          <span class="card-file">main.az · line 6</span>
          <span class="card-badge" style="color:#ff9bab;background:rgba(255,107,129,.08);border-color:rgba(255,107,129,.2)">ERROR</span>
        </div>
        <div class="error-body">
          <pre class="error-snippet"><span class="bad">6 | say total / count</span></pre>
          <div class="error-card-demo">
            <div class="err-head">
              <span class="err-badge">error</span>
              <span class="err-kind">runtime · line 6</span>
            </div>
            <div class="err-msg">Cannot divide by zero</div>
            <div class="err-hint"><b>Hint:</b> Check that <span class="mono" style="color:#ffe3a8">count</span> is not zero before dividing.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="wrap">
      <div class="start reveal">
        <div>
          <span class="eyebrow">Start now</span>
          <h2>Your first program is one install away.</h2>
          <p>
            Install AzLang for Windows and the command, Studio, docs, and editor support
            are ready in one step. Prefer to try it first? The browser Studio needs no
            installation at all.
          </p>
          <div class="start-actions">
            <a class="btn btn-primary" href="#download">
              <svg class="ic" aria-hidden="true"><use href="#i-download"/></svg>
              Get AzLang for Windows
            </a>
            <a class="btn btn-ghost" href="ide.html">
              <svg class="ic" aria-hidden="true"><use href="#i-play"/></svg>
              Run in the browser
            </a>
          </div>
        </div>

        <div class="terminal">
          <div class="terminal-head">
            <div class="dots"><i></i><i></i><i></i></div>
            <span>Windows PowerShell</span>
            <span style="margin-left:auto;text-transform:none;letter-spacing:0;color:#50607f">Bundled Node.js</span>
          </div>
          <div class="terminal-body" id="terminalBody">
<div class="cmd"><span class="prompt">PS&gt;</span> azlang examples/hello.az</div>
<div class="res">Hello, world!</div>
<div class="res">Welcome, friend!</div>
<div class="cmd"><span class="prompt">PS&gt;</span> azlang --check examples/tour.az</div>
<div class="res">OK: examples/tour.az (52 top-level statements)</div>
<div class="cmd"><span class="prompt">PS&gt;</span> azlang <span class="cm"># interactive shell</span></div>
<div class="res">AzLang 2.1 &gt; <span style="color:#d9e4f8">say 6 * 7</span></div>
<div class="res">42</div>
          </div>
          <div class="terminal-foot">
            <span style="font-size:10.5px;color:var(--dim)">No packages. No build step.</span>
            <button class="copy-btn" id="copyCmd" type="button">
              <svg class="ic" aria-hidden="true"><use href="#i-copy"/></svg>
              <span id="copyLabel">Copy command</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="mark"><svg aria-hidden="true"><use href="#i-play"/></svg></span>
      <b>AzLang</b>
      <span class="footer-note">v2.1 · This page is generated by AzLang</span>
    </div>
    <div class="footer-links">""")

for link in footer_links
  let extra = ""
  if starts(link.href, "http")
    extra = ' target="_blank" rel="noopener"'
  end
  add('      <a href="' + link.href + '"' + extra + '>' + link.label + '</a>')
end

add(r"""    </div>
  </div>
</footer>""")

add('<script type="application/json" id="showcaseData">' + replace(json_encode(showcase_samples), "<", "\\u003c") + '</script>')

add(r"""<script src="assets/site.js"></script>
</body>
</html>""")

# ------------------------------------------------------------
# Write the file
# ------------------------------------------------------------

say join(out, "\n")

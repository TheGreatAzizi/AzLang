# ============================================================
# AzLang landing page generator
#
# The website is written in AzLang. This program prints the
# complete index.html file. Run `node build-site.js` to rebuild.
# ============================================================

let out = []

fun add(part = "")
  append(out, part)
end

fun icon(name, cls = "ic")
  return '<svg class="' + cls + '" aria-hidden="true"><use href="#' + name + '"/></svg>'
end

fun esc_html(text)
  return replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
end

fun code_sample(text)
  return '<code class="az-sample">' + esc_html(text) + '</code>'
end


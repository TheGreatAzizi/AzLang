let hero_code = r"""class Greeter
  fun init(name)
    this.name = name
  end

  fun greet()
    return "Hello, {this.name}!"
  end
end

let people = ["Ada", "Grace", "Linus"]

for name in people
  say new Greeter(name).greet()
end"""


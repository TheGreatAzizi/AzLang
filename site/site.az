      <div class="features-grid">""")

for feature in features
  add('        <article class="feature reveal">')
  add('          <div class="ficon">' + icon(feature.icon) + '</div>')
  add('          <h3>' + feature.title + '</h3>')
  add('          <p>' + feature.body + '</p>')
  if has(feature, "html")
    add('          ' + feature.html)
  else
    add('          <div class="sample">' + code_sample(feature.sample) + '</div>')
  end
  add('        </article>')
  add('')
end

